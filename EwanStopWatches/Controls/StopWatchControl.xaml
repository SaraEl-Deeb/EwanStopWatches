<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EwanStopWatches.Controls.StopWatchControl">

    <VerticalStackLayout Padding="10" Spacing="15">
        <ImageButton
            Source="bin.png"
            WidthRequest="36"
            HeightRequest="36"
            Padding="6"
            HorizontalOptions="End"
            BackgroundColor="Transparent"
            Aspect="AspectFit"
            SemanticProperties.Description="Delete stopwatch"
            Clicked="OnDeleteClicked" />
        <!-- Stopwatch Name -->
        <Editor 
            Text="{Binding Name}"
            FontSize="20"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            TextColor="{AppThemeBinding Light=#1f1f1f, Dark=#ffffff}" />

        <!-- Elapsed Time Display -->
        <Frame 
            BorderColor="{AppThemeBinding Light=#e0e0e0, Dark=#3e3e3e}"
            CornerRadius="10"
            HasShadow="True"
            Padding="20"
            WidthRequest="300">
            <Label 
                Text="{Binding ElapsedTime, StringFormat='{0} ms'}"
                FontSize="40"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                TextColor="{AppThemeBinding Light=#512BD4, Dark=#C399E5}" />
        </Frame>

        <!-- Control Buttons -->
        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
            <Button 
                Text="Start"
                Padding="15,10"
                CornerRadius="8"
                BackgroundColor="#512BD4"
                TextColor="White"
                FontAttributes="Bold"
                Command="{Binding StartStopWatchCommand}" />

            <Button 
                Text="Stop"
                Padding="15,10"
                CornerRadius="8"
                BackgroundColor="#DC3545"
                TextColor="White"
                FontAttributes="Bold"
                Command="{Binding StopWatchCommand}" />

            <Button 
                Text="Reset"
                Padding="15,10"
                CornerRadius="8"
                BackgroundColor="#6C757D"
                TextColor="White"
                FontAttributes="Bold" 
                Command="{Binding ResetStopWatchCommand}"/>
        </HorizontalStackLayout>

        <!-- Time Details (Optional) -->
        <Grid ColumnDefinitions="100,100" RowDefinitions="Auto,Auto" Padding="0" HorizontalOptions="Center">
            <Label Text="Start:" Grid.Column="0" Grid.Row="0" FontSize="12" TextColor="{AppThemeBinding Light=#666666, Dark=#999999}" />
            <Label Text="{Binding StartTime}" Grid.Column="1" Grid.Row="0" FontSize="12" HorizontalTextAlignment="End" />

            <Label Text="End:" Grid.Column="0" Grid.Row="1" FontSize="12" TextColor="{AppThemeBinding Light=#666666, Dark=#999999}" />
            <Label Text="{Binding EndTime}" Grid.Column="1" Grid.Row="1" FontSize="12" HorizontalTextAlignment="End" />
        </Grid>
    </VerticalStackLayout>
    
</ContentView>
