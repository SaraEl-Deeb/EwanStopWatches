<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrls="clr-namespace:EwanStopWatches.Controls"
             x:Class="EwanStopWatches.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Button
                Text="Add stopwatch"
                Padding="15,10"
                HorizontalOptions="Center"
                BackgroundColor="#512BD4"
                TextColor="White"
                FontAttributes="Bold"
                Clicked="OnAddStopwatchClicked" />

            <VerticalStackLayout
                x:Name="StopwatchesLayout"
                Spacing="25">
                <ctrls:StopWatchControl />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
